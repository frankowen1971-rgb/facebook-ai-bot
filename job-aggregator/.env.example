# ============================================================
# JobBoardBD — API Keys Configuration
# Copy this file to .env.local and fill in your keys
# ============================================================

# --- USAJobs (US Government Jobs) ---
# Signup: https://developer.usajobs.gov/APIRequest/Index
# Free, instant approval
USAJOBS_API_KEY=
USAJOBS_EMAIL=your@email.com

# --- Adzuna (Global Job Search) ---
# Signup: https://developer.adzuna.com/signup
# Free tier: 250 requests/month
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Jooble ---
# Signup: https://jooble.org/api/about
# Free: email them for a key
JOOBLE_API_KEY=

# --- JSearch via RapidAPI ---
# Signup: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
# Free tier: 200 requests/month
RAPIDAPI_KEY=

# --- Reed.co.uk (UK Jobs) ---
# Signup: https://www.reed.co.uk/developers/jobseeker
# Free with registration
REED_API_KEY=

# --- Findwork.dev ---
# Signup: https://findwork.dev/api-token-auth/
# Free with registration
FINDWORK_API_KEY=
